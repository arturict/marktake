# Required. Use at least 12 characters. Never commit the real value.
MARKTAKE_ADMIN_PASSWORD=replace-with-a-long-random-password

# The externally reachable origin, without a trailing slash.
MARKTAKE_PUBLIC_URL=http://localhost:4180

# Persistent data, SQLite database, uploads, and temporary upload files.
MARKTAKE_DATA_DIR=/data

# Conservative defaults. Increase only after checking disk and reverse-proxy limits.
MARKTAKE_MAX_UPLOAD_BYTES=536870912
MARKTAKE_MAX_STORAGE_BYTES=5368709120

# Set true only when the public URL is HTTPS.
MARKTAKE_SECURE_COOKIES=false

HOST=0.0.0.0
PORT=4180
