{
  "name": "marktake",
  "version": "0.1.0",
  "private": true,
  "description": "A focused, self-hosted review server for browser-ready video cuts.",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @marktake/server dev\" \"pnpm --filter @marktake/web dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "start": "pnpm --filter @marktake/server start"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "9.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.7"
  }
}
